# Copy to .env. Existing process environment variables take precedence.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL_ALIAS=deepseekapiv41flash
DEEPSEEK_TEMPERATURE=0.3
DATABASE_PATH=data/vocabulary.sqlite3
# Optional HTTP Basic Auth for the whole app; leave both credentials empty to disable it.
APP_USERNAME=
APP_PASSWORD=
# Hosts allowed to reach the app. Include the server's public IP for a public demo.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1],testserver
SPACY_MODEL=en_core_web_sm
DICTIONARY_ENABLED=true
DAILY_NEW_LIMIT=10
SESSION_TTL_SECONDS=1800
# Model requests use the cloud. SQLite, notes, traces, and review history stay local.
# LangSmith tracing is disabled by default; do not enable it for private articles.
LANGSMITH_TRACING=false
